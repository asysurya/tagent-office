{
  "name": "tagent-office",
  "version": "0.1.0",
  "private": true,
  "description": "Your AI team, in your browser. Self-hosted AI agent office.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "bun packages/cli/src/index.ts start",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --filter '*' typecheck",
    "lint": "eslint .",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/bun": "^1.3.14",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0"
  }
}
