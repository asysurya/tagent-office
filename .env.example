# Tagent Office — environment variables
# Copy to `.env` and adjust. Environment variables always WIN over
# tagent-office.config.json values (see docs/configuration.md).

# ---------------------------------------------------------------------------
# Quick start: LLM via any OpenAI-compatible endpoint (Groq, OpenRouter,
# Ollama, LM Studio, vLLM, ...). Setting BASE_URL switches the default
# provider to a configurable "custom" openai-compatible provider.
# ---------------------------------------------------------------------------
# Groq example:
TAGENT_OFFICE_BASE_URL=https://api.groq.com/openai/v1
TAGENT_OFFICE_API_KEY=your-groq-key-here
TAGENT_OFFICE_MODEL=llama-3.3-70b-versatile

# OpenAI native example:
# TAGENT_OFFICE_BASE_URL=https://api.openai.com/v1
# TAGENT_OFFICE_API_KEY=sk-your-openai-key
# TAGENT_OFFICE_MODEL=gpt-4o-mini

# Ollama (local) example:
# TAGENT_OFFICE_BASE_URL=http://localhost:11434/v1
# TAGENT_OFFICE_API_KEY=ollama
# TAGENT_OFFICE_MODEL=qwen2.5-coder:7b

# ---------------------------------------------------------------------------
# Daemon
# ---------------------------------------------------------------------------
TAGENT_OFFICE_PORT=4020
TAGENT_OFFICE_STORAGE=./storage
TAGENT_OFFICE_WORKSPACE=demo
TAGENT_OFFICE_LOG_LEVEL=info
TAGENT_OFFICE_MAX_WORKERS=4

# ---------------------------------------------------------------------------
# Web GUI (apps/web) — where the browser GUI finds the daemon.
# Default: http://localhost:4020 (direct mode, standard /socket.io path).
# Set to an EMPTY string to enable same-origin proxy mode (uses next.config.ts
# rewrites /api/tagent/* and /tagent-socket/* — useful when GUI and daemon are
# served from one origin, e.g. the embedded binary or behind a reverse proxy).
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_DAEMON_URL=http://localhost:4020
